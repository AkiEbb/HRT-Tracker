{
  "name": "@hrt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema.sqlite": "./src/schema.sqlite.ts",
    "./schema.pg": "./src/schema.pg.ts",
    "./store": "./src/store/sql.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun run generate:sqlite && bun run generate:pg",
    "generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "drizzle-kit": "^0.31.11"
  }
}
